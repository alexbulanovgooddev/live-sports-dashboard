{
	"name": "@live-sports-dashboard/backend",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env --watch src/index.ts",
		"start": "node --env-file-if-exists=.env src/index.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@live-sports-dashboard/shared": "workspace:*",
		"drizzle-orm": "^0.45.3",
		"express": "^5.2.1",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/express": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:"
	},
	"lint-staged": {
		"*.{ts,js,mjs}": "eslint",
		"*.{ts,js,mjs,json,md}": "prettier --check --ignore-path ../.prettierignore"
	}
}
